@model MovieStore.Models.Movie

@{
    ViewData["Title"] = Model.Title + " - CINETORE";
}

@section Styles {
    <link rel="stylesheet" href="~/css/movie-details.css" asp-append-version="true" />
}

<div class="movie-page">
    <div class="container">

        <h2 class="movie-title"><strong>@Model.Title</strong></h2>

        <section class="movie-details">

            <div class="movie-info">
                <div class="detail-row">
                    <span class="detail-label">Genre:</span>
                    <span class="detail-value">@Model.Genre</span>
                </div>

                @if (Model.ReleaseYear.HasValue)
                {
                    <div class="detail-row">
                        <span class="detail-label">Release Year:</span>
                        <span class="detail-value">@Model.ReleaseYear</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Rating))
                {
                    <div class="detail-row">
                        <span class="detail-label">Rating:</span>
                        <span class="detail-value">@Model.Rating</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Director))
                {
                    <div class="detail-row">
                        <span class="detail-label">Director:</span>
                        <span class="detail-value">@Model.Director</span>
                    </div>
                }

                <div class="detail-row">
                    <span class="detail-label">Price:</span>
                    <span class="detail-value">$@Model.Price.ToString("F2")</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="movie-description">
                        <span class="detail-label">Description:</span>
                        <div class="detail-value">@Model.Description</div>
                    </div>
                }

                @if (Model.CastMembers.Any())
                {
                    <section class="cast-section">
                        <h3 class="section-title">Cast</h3>
                        <div class="cast-list">
                            @foreach (var member in Model.CastMembers)
                            {
                                <div class="cast-card">
                                    <a href="https://www.google.com/search?q=@Uri.EscapeDataString(member.Name + " actor")" target="_blank" rel="noopener noreferrer">
                                        <span class="cast-photo-wrap">
                                            <img src="@member.GetPhotoUrl()" alt="@member.Name" class="cast-photo"
                                                 onerror="this.onerror=null;this.src='/images/favicon.png';this.style.objectFit='contain';this.style.padding='20px';" />
                                        </span>
                                        <span class="cast-name">@member.Name</span>
                                        <span class="cast-role">@member.Role</span>
                                    </a>
                                </div>
                            }
                        </div>
                    </section>
                }

                <div class="movie-actions" style="margin-top:24px;">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-cinetore">
                        <i class="fa-solid fa-pen"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-delete">
                        <i class="fa-solid fa-trash"></i> Delete
                    </a>
                    <a asp-action="Index" class="btn btn-cinetore">
                        <i class="fa-solid fa-arrow-left"></i> Back to Browse
                    </a>
                </div>
            </div>

            <div class="movie-poster-area">
                @if (!string.IsNullOrEmpty(Model.PosterUrl))
                {
                    <img src="@Model.PosterUrl" alt="@Model.Title poster" class="movie-poster"
                         onerror="this.onerror=null;this.src='/images/favicon.png';this.style.objectFit='contain';this.style.padding='20px';" />
                }
                else
                {
                    <div style="width:100%;height:390px;background:var(--surface-raised);border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;">
                        <i class="fa-solid fa-film" style="font-size:64px;color:var(--accent);"></i>
                        <span style="margin-top:16px;color:var(--secondary-text);font-size:13px;">No poster available</span>
                    </div>
                }

                <div class="movie-actions" style="margin-top:12px;">
                    <button type="button" class="btn btn-accent watch-now" style="flex:1;">
                        <i class="fa-solid fa-play"></i> Watch Now
                    </button>
                    <button type="button" class="btn btn-cinetore download-movie" style="flex:1;">
                        <i class="fa-solid fa-download"></i> Download
                    </button>
                </div>
            </div>

        </section>

    </div>
</div>
