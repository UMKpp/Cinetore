@model MovieStore.Models.Movie

@{
    ViewData["Title"] = "Edit — " + Model.Title;
}

@section Styles {
    <link rel="stylesheet" href="~/css/movie-details.css" asp-append-version="true" />
}

<div class="movie-page">
    <div class="container">

        <h2 class="movie-title">Edit: @Model.Title</h2>

        <div class="row">
            <div class="col-md-7">
                <div class="form-section">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Cast" />
                        <div asp-validation-summary="ModelOnly" class="form-message"></div>

                        <div class="form-group">
                            <label asp-for="Title" class="control-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="form-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Genre" class="control-label"></label>
                            <input asp-for="Genre" class="form-control" />
                            <span asp-validation-for="Genre" class="form-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ReleaseYear" class="control-label"></label>
                            <input asp-for="ReleaseYear" class="form-control" type="number" min="1888" max="2040" />
                            <span asp-validation-for="ReleaseYear" class="form-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Director" class="control-label"></label>
                            <input asp-for="Director" class="form-control" />
                            <span asp-validation-for="Director" class="form-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Rating" class="control-label"></label>
                            <input asp-for="Rating" class="form-control" />
                            <span asp-validation-for="Rating" class="form-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description" class="control-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="form-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="PosterUrl" class="control-label"></label>
                            <input asp-for="PosterUrl" class="form-control" placeholder="https://…" />
                            <span asp-validation-for="PosterUrl" class="form-message"></span>
                            <small style="color:var(--secondary-text);font-size:12px;">Paste an image URL for the movie poster.</small>
                        </div>

                        <div class="form-group">
                            <label asp-for="Price" class="control-label"></label>
                            <input asp-for="Price" class="form-control" type="number" min="0" max="1000" step="0.01" />
                            <span asp-validation-for="Price" class="form-message"></span>
                        </div>

                        <div class="movie-actions" style="margin-top:24px;">
                            <input type="submit" value="Save Changes" class="btn btn-accent" style="flex:2;" />
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-cinetore" style="flex:1;text-align:center;">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.PosterUrl))
            {
                <div class="col-md-4 col-md-offset-1">
                    <div style="margin-top:20px;">
                        <p style="color:var(--secondary-text);font-size:13px;margin-bottom:8px;">Current Poster</p>
                        <img src="@Model.PosterUrl" alt="@Model.Title poster"
                             style="width:100%;max-width:240px;border-radius:8px;object-fit:cover;"
                             onerror="this.style.display='none';" />
                    </div>
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
