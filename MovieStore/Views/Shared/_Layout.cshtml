<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CINETORE</title>
    <link rel="icon" type="image/x-icon" href="~/images/favicon.png" />

    @* Bootstrap 3.4.1 from CDN — frontend CSS is written for Bootstrap 3 class names *@
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <nav class="navbar cinetore-navbar">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse"
                        data-target="#cinetore-navbar" aria-expanded="false">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand cinetore-logo" asp-controller="Home" asp-action="Index">CINETORE</a>
            </div>

            <div class="collapse navbar-collapse" id="cinetore-navbar">
                <ul class="nav navbar-nav navbar-right">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Movies" asp-action="Index">Genres</a></li>
                    <li>
                        <button id="themeToggle" class="theme-toggle" type="button" aria-label="Toggle theme">
                            <i id="themeIcon" class="fa-solid fa-sun"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <div class="floating-actions">
        <button type="button" class="floating-cta" id="requestMovieBtn" aria-label="Request Movie">
            <i class="fa-solid fa-film"></i>
            <span class="cta-label">Request Movie</span>
        </button>
    </div>

    <footer class="cinetore-footer">
        <div class="container">
            <div class="row">

                <div class="col-sm-4 footer-column">
                    <div class="footer-brand">CINETORE</div>
                    <div class="footer-contact">
                        <p>
                            <i class="fa-solid fa-envelope"></i>
                            <a href="mailto:cinetore@gmail.com">cinetore@gmail.com</a>
                        </p>
                        <p>
                            <i class="fa-solid fa-phone"></i>
                            <a href="tel:+941122334567">+94 11 223 34567</a>
                        </p>
                        <p>
                            <i class="fa-solid fa-location-dot"></i>
                            Cinetore, Colombo 7
                        </p>
                    </div>
                </div>

                <div class="col-sm-4 footer-column">
                    <h4 class="footer-heading">Genres</h4>
                    <ul class="footer-links">
                        <li><a asp-controller="Movies" asp-action="Index" asp-route-genre="Action">Action</a></li>
                        <li><a asp-controller="Movies" asp-action="Index" asp-route-genre="Sci-Fi">Sci-Fi</a></li>
                        <li><a asp-controller="Movies" asp-action="Index" asp-route-genre="Drama">Drama</a></li>
                        <li><a asp-controller="Movies" asp-action="Index" asp-route-genre="RomCom">RomCom</a></li>
                        <li><a asp-controller="Movies" asp-action="Index" asp-route-genre="Animation">Animation</a></li>
                        <li><a asp-controller="Movies" asp-action="Index" asp-route-genre="Horror">Horror</a></li>
                    </ul>
                </div>

                <div class="col-sm-4 footer-column">
                    <h4 class="footer-heading">Follow Us</h4>
                    <div class="footer-socials">
                        <a href="#" aria-label="Facebook" data-social-placeholder="Facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>
                        <a href="#" aria-label="X" data-social-placeholder="X">
                            <i class="fa-brands fa-x-twitter"></i>
                        </a>
                        <a href="#" aria-label="Instagram" data-social-placeholder="Instagram">
                            <i class="fa-brands fa-instagram"></i>
                        </a>
                    </div>
                    <div class="footer-copyright">
                        &copy; 2026 Cinetore. All rights reserved.
                    </div>
                </div>

            </div>
        </div>
    </footer>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>


    <script src="~/js/cinetore.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
